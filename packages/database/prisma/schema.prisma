generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOKTER
  PERAWAT
}

enum Gender {
  MALE
  FEMALE
}

enum PatientIdentifierType {
  NIK
  MOTHER_NIK
  PASSPORT
  FAMILY_CARD
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  EXPIRED
}

enum PatientNameUse {
  OFFICIAL
  PREFERRED
  ALIAS
  OLD
}

enum TelecomSystem {
  PHONE
  EMAIL
  FAX
  OTHER
}

enum TelecomUse {
  MOBILE
  HOME
  WORK
  TEMP
  OTHER
}

enum AddressUse {
  HOME
  WORK
  TEMP
  OLD
  OTHER
}

enum AddressType {
  PHYSICAL
  POSTAL
  BOTH
}

enum PatientRelationshipCode {
  MOTHER
  FATHER
  CHILD
  GUARDIAN
  CAREGIVER
  OTHER
}

enum EncounterStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MedicalRecordStatus {
  DRAFT
  FINAL
}

enum AllergyReviewStatus {
  KNOWN
  NONE_KNOWN
  NOT_REVIEWED
}

enum OutpatientDisposition {
  HOME
  REFERRED
  ADMITTED
  OTHER
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MasterDataImportStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MasterRegionLevel {
  PROVINCE
  REGENCY
  DISTRICT
  VILLAGE
}

enum OrganizationType {
  HEALTHCARE_FACILITY
  SUB_ORGANIZATION
}

enum LocationType {
  BUILDING
  FLOOR
  ROOM
  OTHER
}

enum LocationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LocationMode {
  INSTANCE
  KIND
}

model HealthcareOrganization {
  id          String               @id @default(uuid())
  code        String               @unique @db.VarChar(64)
  name        String               @db.VarChar(150)
  type        OrganizationType     @default(HEALTHCARE_FACILITY)
  parentId    String?
  addressText String?              @db.VarChar(500)
  phone       String?              @db.VarChar(32)
  email       String?              @db.VarChar(255)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  parent      HealthcareOrganization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    HealthcareOrganization[] @relation("OrganizationHierarchy")
  locations   Location[]           @relation("OrganizationLocations")
  practitioners User[]             @relation("OrganizationPractitioners")
  encounters   Encounter[]         @relation("OrganizationEncounters")

  @@index([parentId, active])
  @@index([active, name])
}

model Location {
  id             String                @id @default(uuid())
  organizationId String
  parentId       String?
  code           String                @db.VarChar(64)
  name           String                @db.VarChar(150)
  type           LocationType          @default(ROOM)
  description    String?               @db.VarChar(500)
  status         LocationStatus       @default(ACTIVE)
  mode           LocationMode          @default(INSTANCE)
  physicalTypeCode String?             @db.VarChar(32)
  addressText    String?               @db.VarChar(500)
  city           String?               @db.VarChar(100)
  postalCode     String?               @db.VarChar(16)
  countryCode    String                @default("ID") @db.VarChar(2)
  latitude       Decimal?              @db.Decimal(10, 7)
  longitude      Decimal?              @db.Decimal(10, 7)
  altitude       Decimal?              @db.Decimal(10, 3)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   HealthcareOrganization @relation("OrganizationLocations", fields: [organizationId], references: [id], onDelete: Restrict)
  parent         Location?             @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Location[]            @relation("LocationHierarchy")
  practitioners  User[]                @relation("LocationPractitioners")
  practitionerAssignments PractitionerLocationAssignment[] @relation("LocationPractitionerAssignments")
  encounters     Encounter[]           @relation("LocationEncounters")
  queueCounters  EncounterQueueCounter[] @relation("LocationQueueCounters")

  @@unique([organizationId, code])
  @@index([organizationId, active, name])
  @@index([parentId])
}

// Generic import metadata keeps refresh history separate from any provider
// payload. The domain remains a string so new master data datasets can be
// introduced without changing this table's shape.
model MasterDataImportRun {
  id                   String                @id @default(uuid())
  domain               String                @db.VarChar(64)
  source               String                @db.VarChar(64)
  sourceVersion        String?               @db.VarChar(128)
  status               MasterDataImportStatus @default(PENDING)
  recordsSeen          Int                   @default(0)
  recordsUpserted      Int                   @default(0)
  recordsDeactivated   Int                   @default(0)
  attemptedAt          DateTime              @default(now())
  completedAt          DateTime?
  succeededAt          DateTime?
  errorCode            String?               @db.VarChar(128)
  errorMessage         String?               @db.VarChar(1000)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([domain, attemptedAt])
  @@index([domain, status, attemptedAt])
}

model MasterRegion {
  id            String           @id @default(uuid())
  level         MasterRegionLevel
  code          String           @db.VarChar(32)
  parentCode    String?          @db.VarChar(32)
  bpsCode       String?          @db.VarChar(32)
  name          String           @db.VarChar(160)
  active        Boolean          @default(true)
  source        String           @db.VarChar(64)
  sourceVersion String?          @db.VarChar(128)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([level, code])
  @@index([level, parentCode, active, name])
  @@index([code])
}

model MasterMaritalStatus {
  code          String   @id @db.VarChar(32)
  display       String   @db.VarChar(160)
  active        Boolean  @default(true)
  displayOrder  Int
  source        String   @db.VarChar(64)
  sourceVersion String?  @db.VarChar(128)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, displayOrder, display])
}

// Generic linkage keeps external provider identifiers out of domain models.
// SATUSEHAT is the first adapter, but the shape remains provider-agnostic.
model ExternalResourceLink {
  id                 String   @id @default(uuid())
  provider           String   @db.VarChar(64)
  environment        String   @db.VarChar(32)
  resourceType       String   @db.VarChar(64)
  localResourceType  String   @db.VarChar(64)
  localResourceId    String
  externalResourceId String   @db.VarChar(128)
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([provider, environment, resourceType, localResourceType, localResourceId], name: "localResourceScope")
  @@unique([provider, environment, resourceType, externalResourceId], name: "externalResourceScope")
  @@index([localResourceType, localResourceId])
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  fullName     String
  role         Role
  nik          String?     @unique @db.VarChar(16)
  birthDate    DateTime?   @db.Date
  gender       Gender?
  active       Boolean     @default(true)
  sipNumber    String?
  strNumber    String?
  organizationId String?
  locationId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  organization HealthcareOrganization? @relation("OrganizationPractitioners", fields: [organizationId], references: [id], onDelete: SetNull)
  location     Location?              @relation("LocationPractitioners", fields: [locationId], references: [id], onDelete: SetNull)
  locationAssignments PractitionerLocationAssignment[] @relation("PractitionerLocationAssignments")
  encounters   Encounter[] @relation("DoctorEncounters")
  encounterStatusHistory EncounterStatusHistory[] @relation("EncounterStatusActor")
  clinicalObservations ClinicalObservation[] @relation("ObservationPerformer")

  @@index([role, active, fullName])
  @@index([organizationId, active, fullName])
  @@index([locationId, active, fullName])
}

model PractitionerLocationAssignment {
  practitionerId String
  locationId     String
  createdAt      DateTime @default(now())
  practitioner   User     @relation("PractitionerLocationAssignments", fields: [practitionerId], references: [id], onDelete: Cascade)
  location       Location @relation("LocationPractitionerAssignments", fields: [locationId], references: [id], onDelete: Cascade)

  @@id([practitionerId, locationId])
  @@index([locationId, practitionerId])
}

model Patient {
  id                 String                @id @default(uuid())
  nik                String?               @unique @db.VarChar(16)
  fullName           String                @db.VarChar(150)
  birthDate          DateTime              @db.Date
  gender             Gender
  address            String?               @db.VarChar(500)
  phone              String?               @db.VarChar(16)
  medicalRecNo       String                @unique @db.VarChar(32)
  satusehatId        String?               @db.VarChar(64)
  active             Boolean               @default(true)
  birthPlaceText     String?               @db.VarChar(255)
  multipleBirthOrder Int?
  deceasedAt         DateTime?
  maritalStatusCode  String?               @db.VarChar(32)
  citizenshipCode    String?               @db.VarChar(3)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  identifiers        PatientIdentifier[]
  names              PatientName[]
  telecoms           PatientTelecom[]
  addresses          PatientAddress[]
  relationshipsFrom  PatientRelationship[] @relation("PatientRelationshipSubject")
  relationshipsTo    PatientRelationship[] @relation("PatientRelationshipTarget")
  encounters         Encounter[]
}

model PatientIdentifier {
  id                 String                @id @default(uuid())
  patientId          String
  type               PatientIdentifierType
  system             String                @db.VarChar(255)
  value              String                @db.VarChar(255)
  normalizedValue    String                @db.VarChar(255)
  verificationStatus VerificationStatus    @default(UNVERIFIED)
  isPrimary          Boolean               @default(false)
  active             Boolean               @default(true)
  issuer             String?               @db.VarChar(255)
  validFrom          DateTime?
  validTo            DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  patient            Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, type])
  @@index([system, normalizedValue])
}

model PatientName {
  id        String         @id @default(uuid())
  patientId String
  use       PatientNameUse
  text      String         @db.VarChar(255)
  given     String[]       @default([])
  family    String?        @db.VarChar(150)
  prefix    String[]       @default([])
  suffix    String[]       @default([])
  validFrom DateTime?
  validTo   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, use])
}

model PatientTelecom {
  id                 String             @id @default(uuid())
  patientId          String
  system             TelecomSystem
  value              String             @db.VarChar(255)
  normalizedValue    String             @db.VarChar(255)
  use                TelecomUse
  rank               Int                @default(1)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  active             Boolean            @default(true)
  validFrom          DateTime?
  validTo            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, system, active])
  @@index([system, normalizedValue])
}

model PatientAddress {
  id           String      @id @default(uuid())
  patientId    String
  use          AddressUse
  type         AddressType
  text         String?     @db.VarChar(500)
  lines        String[]    @default([])
  postalCode   String?     @db.VarChar(16)
  countryCode  String?     @db.VarChar(2)
  provinceCode String?     @db.VarChar(16)
  provinceName String?     @db.VarChar(100)
  regencyCode  String?     @db.VarChar(16)
  regencyName  String?     @db.VarChar(100)
  districtCode String?     @db.VarChar(16)
  districtName String?     @db.VarChar(100)
  villageCode  String?     @db.VarChar(16)
  villageName  String?     @db.VarChar(100)
  active       Boolean     @default(true)
  validFrom    DateTime?
  validTo      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, use, active])
  @@index([provinceCode, regencyCode, districtCode, villageCode])
}

model PatientRelatedPerson {
  id            String                @id @default(uuid())
  fullName      String                @db.VarChar(150)
  gender        Gender?
  birthDate     DateTime?             @db.Date
  phone         String?               @db.VarChar(32)
  email         String?               @db.VarChar(255)
  addressText   String?               @db.VarChar(500)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  relationships PatientRelationship[]
}

model PatientRelationship {
  id               String                  @id @default(uuid())
  patientId        String
  relatedPatientId String?
  relatedPersonId  String?
  relationshipCode PatientRelationshipCode
  startAt          DateTime?
  endAt            DateTime?
  isGuardian       Boolean                 @default(false)
  contactPriority  Int?
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  patient          Patient                 @relation("PatientRelationshipSubject", fields: [patientId], references: [id], onDelete: Cascade)
  relatedPatient   Patient?                @relation("PatientRelationshipTarget", fields: [relatedPatientId], references: [id], onDelete: Restrict)
  relatedPerson    PatientRelatedPerson?   @relation(fields: [relatedPersonId], references: [id], onDelete: Restrict)

  @@index([patientId, relationshipCode, active])
  @@index([relatedPatientId])
  @@index([relatedPersonId])
}

model Encounter {
  id              String                @id @default(uuid())
  encounterNumber String                @unique @db.VarChar(32)
  patientId       String
  doctorId        String
  organizationId  String
  locationId      String
  queueDate       DateTime              @db.Date
  queueNumber     Int
  status          EncounterStatus       @default(WAITING)
  arrivedAt       DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  version         Int                   @default(1)
  patient         Patient               @relation(fields: [patientId], references: [id])
  doctor          User                  @relation("DoctorEncounters", fields: [doctorId], references: [id])
  organization    HealthcareOrganization @relation("OrganizationEncounters", fields: [organizationId], references: [id], onDelete: Restrict)
  location        Location              @relation("LocationEncounters", fields: [locationId], references: [id], onDelete: Restrict)
  statusHistory   EncounterStatusHistory[]
  medicalRecord   MedicalRecord?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([locationId, queueDate, queueNumber])
  @@index([queueDate, locationId, status])
  @@index([patientId, locationId, queueDate, status])
  @@index([doctorId, queueDate, status])
}

model EncounterStatusHistory {
  id           String          @id @default(uuid())
  encounterId  String
  status       EncounterStatus
  periodStart  DateTime
  periodEnd    DateTime?
  actorUserId  String?
  actorUsername String        @db.VarChar(128)
  actorRole    Role
  createdAt    DateTime        @default(now())
  encounter    Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  actorUser    User?           @relation("EncounterStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([encounterId, periodStart])
  @@index([actorUserId, createdAt])
}

model EncounterQueueCounter {
  id              String   @id @default(uuid())
  locationId      String
  queueDate       DateTime @db.Date
  lastIssuedNumber Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  location        Location @relation("LocationQueueCounters", fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, queueDate])
}

model MedicalRecord {
  id                String              @id @default(uuid())
  encounterId       String              @unique
  status            MedicalRecordStatus @default(DRAFT)
  version           Int                 @default(1)
  authoredBy        String?             @db.VarChar(128)
  authoredAt        DateTime?
  finalizedBy       String?             @db.VarChar(128)
  finalizedAt       DateTime?
  serviceProfile    String              @default("OUTPATIENT_GENERAL") @db.VarChar(64)
  validationProfile String              @default("OUTPATIENT_GENERAL_V1") @db.VarChar(64)
  chiefComplaint    String?
  presentIllness    String?
  allergyReviewStatus AllergyReviewStatus?
  allergyDetails     String?
  physicalExam      String?
  education         String?
  carePlan          String?
  disposition       OutpatientDisposition?
  anamnesis         String?
  systolic          Int?
  diastolic         Int?
  heartRate         Int?
  temperature       Float?
  weight            Float?
  height            Float?
  encounter         Encounter           @relation(fields: [encounterId], references: [id])
  observations      ClinicalObservation[]
  diagnoses         Diagnosis[]
  prescriptions     Prescription[]
  auditEvents       MedicalRecordAuditEvent[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// Typed clinical child records remain local-first. Provider adapters translate
// their code/value representation into the remote resource contract.
model ClinicalObservation {
  id                        String         @id @default(uuid())
  medicalRecordId           String
  category                  String         @db.VarChar(64)
  codeSystem                String?        @db.VarChar(255)
  code                      String         @db.VarChar(128)
  codeDisplay               String?        @db.VarChar(255)
  valueType                 String         @db.VarChar(32)
  valueQuantityValue        Float?
  valueQuantityUnit         String?        @db.VarChar(64)
  valueQuantitySystem       String?        @db.VarChar(255)
  valueQuantityCode         String?        @db.VarChar(64)
  valueCodeSystem           String?        @db.VarChar(255)
  valueCode                 String?        @db.VarChar(128)
  valueCodeDisplay          String?        @db.VarChar(255)
  valueBoolean              Boolean?
  valueString               String?
  effectiveAt               DateTime
  performerId               String?
  status                    String         @default("final") @db.VarChar(32)
  provenance                String         @default("original") @db.VarChar(32)
  derivedFromObservationIds String[]       @default([])
  referenceRangeLow         Float?
  referenceRangeHigh        Float?
  interpretationCode        String?        @db.VarChar(128)
  interpretationDisplay     String?        @db.VarChar(255)
  medicalRecord             MedicalRecord  @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  performer                 User?          @relation("ObservationPerformer", fields: [performerId], references: [id], onDelete: Restrict)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([medicalRecordId, effectiveAt])
  @@index([medicalRecordId, code])
  @@index([codeSystem, code])
  @@index([performerId])
}

model MedicalRecordAuditEvent {
  id             String        @id @default(uuid())
  medicalRecordId String
  actorUserId    String?
  actorUsername  String        @db.VarChar(128)
  actorRole      Role
  action         String        @db.VarChar(64)
  entityType     String        @db.VarChar(64)
  entityId       String
  entityVersion  Int
  expectedVersion Int
  occurredAt     DateTime      @default(now())
  requestId      String        @db.VarChar(128)
  correlationId  String        @db.VarChar(128)
  idempotencyKey String        @unique @db.VarChar(128)
  medicalRecord  MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
}

model MasterIcd10 {
  code          String      @id @db.VarChar(32)
  display       String      @db.VarChar(255)
  nameIndo      String?     @db.VarChar(255)
  nameEng       String      @db.VarChar(255)
  active        Boolean     @default(true)
  displayOrder  Int
  source        String      @db.VarChar(64)
  sourceVersion String?     @db.VarChar(128)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([active, displayOrder, code])
  @@index([active, display])
  @@index([active, nameIndo])
}

model Diagnosis {
  id                   String        @id @default(uuid())
  medicalRecordId      String
  icd10Code            String
  isPrimary            Boolean       @default(true)
  satusehatConditionId String?
  medicalRecord        MedicalRecord @relation(fields: [medicalRecordId], references: [id])
}

model Prescription {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicineName    String
  kfaCode         String?
  dosage          String
  frequency       String
  quantity        Int
  instructions    String?
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
}

model SatusehatSyncLog {
  id           String     @id @default(uuid())
  resourceType String
  resourceId   String
  status       SyncStatus @default(PENDING)
  payload      Json
  satusehatId  String?
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([resourceType, resourceId, updatedAt])
}
