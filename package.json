{
  "name": "mitrafaskes-opensource",
  "version": "1.0.0",
  "private": true,
  "description": "Open Source Rekam Medis Elektronik (RME) Indonesia & SATUSEHAT Integration",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run start:dev",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm --workspace=packages/database run generate",
    "db:seed": "npm --workspace=packages/database run seed"
  },
  "keywords": [
    "rme",
    "rekam-medis",
    "satusehat",
    "kemenkes",
    "fhir",
    "icd-10",
    "klinik"
  ],
  "author": "Mitra Faskes Open Source Community",
  "license": "MIT"
}
